---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { CONTACT_EMAIL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { contactPageSchema } from '../../lib/seo';
const lang = 'fr';
const path = route('contact', lang);
const description = 'Écrire à l’éditeur de Prix à la pompe Canada au sujet d’un prix 2026, d’un taux de taxe ou d’une source. Courriel seulement, sans formulaire, sans compte, sans rien à vendre.';
---
<PageLayout title="Contact Prix à la pompe Canada 2026 : corrections et sources" description={description} lang={lang} noindex={true} jsonLd={[contactPageSchema({ name: 'Contact', description, path, lang })]} breadcrumbs={[{ label: 'Contact' }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none">
    <h1>Contact</h1>
    <p>Écrivez à <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. Il n’y a ni formulaire, ni téléphone, ni compte à créer : une seule adresse, lue par les personnes qui tiennent les données à jour.</p>
    <h2>Les messages utiles</h2>
    <ul>
      <li>Un prix ou une date qui diffère de la publication officielle : donnez la ville, le carburant et le lien vers la source.</li>
      <li>Un taux de taxe qui a changé (budget provincial, calendrier de l’accise fédérale, taux trimestriel de l’Alberta).</li>
      <li>Une source officielle que nous n’utilisons pas encore pour votre ville.</li>
      <li>Intégrer le simulateur sur un site d’association ou un blogue : le code est sur la <a href={route('widget', lang)}>page d’intégration</a>.</li>
    </ul>
    <h2>Ce que nous ne pouvons pas faire</h2>
    <p>Nous ne connaissons pas le prix d’une station donnée et ne pouvons pas vous dire où faire le plein. Nous ne sommes ni un régulateur ni un organisme public : une plainte sur le prix d’une station relève de l’Office de la protection du consommateur au Québec, de l’organisme de protection du consommateur de votre province ou, dans l’Atlantique, du régulateur des prix.</p>
    <h2>Éditeur</h2>
    <LegalIdentity lang={lang} />
  </div>
</PageLayout>

---
/** Chaque page de sujet (src/content/guides), version fr. */
import ContentPage from '../../components/ContentPage.astro';
import { GUIDES } from '../../lib/pages';
import type { GuideDef } from '../../lib/page-types';
export function getStaticPaths() {
  return GUIDES.map((page) => ({ params: { slug: page.fr.slug }, props: { page } }));
}
const { page } = Astro.props as { page: GuideDef };
---
<ContentPage page={page} lang="fr" />

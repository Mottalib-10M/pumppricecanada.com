---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { CONTACT_EMAIL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { contactPageSchema } from '../../lib/seo';
const lang = 'en';
const path = route('contact', lang);
const description = 'Write to the publisher of Pump Price Canada about a 2026 price, a tax rate or a source. Email only, no form, no account, and no station or product to sell to you.';
---
<PageLayout title="Contact Pump Price Canada 2026: corrections and sources" description={description} lang={lang} noindex={true} jsonLd={[contactPageSchema({ name: 'Contact', description, path, lang })]} breadcrumbs={[{ label: 'Contact' }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none">
    <h1>Contact</h1>
    <p>Write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. There is no form, no phone line and no account: one address, read by the people who keep the calculators up to date.</p>
    <h2>Messages that help</h2>
    <ul>
      <li>A price or a date that differs from the official publication: give the city, the fuel and the link to the source.</li>
      <li>A tax rate that has changed (a provincial budget, the federal excise schedule, Alberta's quarterly rate).</li>
      <li>An official source we do not use yet for your city.</li>
      <li>Embedding the calculator on a community site or a blog: the code is on the <a href={route('widget', lang)}>embed page</a>.</li>
    </ul>
    <h2>What we cannot do</h2>
    <p>We do not know the price at a given station and cannot tell you where to buy. We are not a regulator or a public body: complaints about a station's price go to your province's consumer protection office or, in the Atlantic provinces, to the price regulator.</p>
    <h2>Publisher</h2>
    <LegalIdentity lang={lang} />
  </div>
</PageLayout>

---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/gas-prices/" title="Gas prices by Canadian city" width="100%" height="820" style="border:0;max-width:900px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the Canadian gas price calculator on your site" description="Community sites and blogs can embed the 2026 gas price calculator by Canadian city, with tomorrow's estimate and fill-up cost, in one line of code. Free, no cookie." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed the calculator', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed the calculator' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the calculator</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code. The embedded calculator follows the daily update of the official figures.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>The calculator runs in the visitor's browser and sends nothing to us or to you. Please keep the link under the calculator: it is how readers find the sources and the method.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/gas-prices/" title="Gas prices by Canadian city" width="100%" height="820" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>

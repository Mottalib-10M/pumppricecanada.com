---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const celi = `<iframe src="${SITE_URL}/embed/tfsa-room/" title="2026 TFSA contribution room" width="100%" height="900" style="border:0;max-width:900px" loading="lazy"></iframe>`;
const reer = `<iframe src="${SITE_URL}/embed/rrsp-vs-tfsa/" title="RRSP vs TFSA 2026" width="100%" height="1000" style="border:0;max-width:900px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the 2026 TFSA and RRSP calculators on your site" description="Associations and blogs can embed the 2026 TFSA contribution room calculator and the RRSP vs TFSA comparison by province with one line of code. Free, no cookie." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed a calculator', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed a calculator' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed a calculator</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code each. When a limit changes, the embedded calculators follow.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>TFSA contribution room</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{celi}</code></pre>
    <h2>RRSP vs TFSA, with your province's brackets</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{reer}</code></pre>
    <p>The calculators run in the visitor's browser and send nothing to us or to you. Please keep the link under the calculator: it is how readers find the sources and the method.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/tfsa-room/" title="2026 TFSA contribution room" width="100%" height="900" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
